APP_NAME="Cafe SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Cafe SaaS ---------------------------------------------------------------
# Comma-separated proxy IP ranges to trust (Cloudflare / load balancer). Empty = trust none.
TRUSTED_PROXIES=
# Browser origins allowed to call the API directly (the Next.js BFF calls server-to-server and needs none).
CORS_ALLOWED_ORIGINS=
TENANT_SUBDOMAIN_BASE=menu.localhost
# Public media disk: "public" locally, "s3" (any S3-compatible storage) in production.
MEDIA_DISK=public

# SMS: "log" (local only), "kavenegar" (production).
SMS_PROVIDER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_VERIFY_TEMPLATE=verify

# Online payments. "fake" works only in local/testing; merchant IDs are per-cafe settings.
PAYMENTS_DRIVER=fake
ZARINPAL_SANDBOX=true
STOREFRONT_URL=http://localhost:3765

OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DAILY_LIMIT_PER_PHONE=8
CUSTOMER_TOKEN_DAYS=30
STAFF_TOKEN_HOURS=12

# Legacy WordPress/WooCommerce database, read-only source for catalog:import-woocommerce.
LEGACY_WP_DB_HOST=127.0.0.1
LEGACY_WP_DB_PORT=3306
LEGACY_WP_DB_DATABASE=local
LEGACY_WP_DB_USERNAME=root
LEGACY_WP_DB_PASSWORD=

# Platform subscription billing (fees go to the platform's own merchant, not a café's).
BILLING_GATEWAY=fake
BILLING_ZARINPAL_MERCHANT=
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
BILLING_VAT_RATE=10
